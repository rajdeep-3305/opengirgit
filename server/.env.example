# OpenGirGit server configuration — copy to `.env` and edit.
# Every value below is read by server/app/config.py (pydantic-settings).

# --- HTTP -------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Where the SQLite database lives (created automatically).
DATA_DIR=data

# --- Auth -------------------------------------------------------------------
# CHANGE THIS before exposing the server to anyone but yourself.
# Use at least 32 characters (HMAC-SHA256 key).  A non-loopback HOST refuses
# to start while this default value, or any key under 32 characters, is in use.
JWT_SECRET=dev-secret-change-me-use-32-bytes-minimum
JWT_EXPIRE_MINUTES=10080
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_SECONDS=30
# Dev mode: when no SMTP is configured the OTP is echoed in the API response
# and printed to the console.  Set to false to always require real email; a
# non-loopback HOST refuses to start while the echo is on without SMTP.
ALLOW_DEV_OTP_ECHO=true

# --- SMTP (optional, enables real OTP email) --------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=secret
# SMTP_FROM=OpenGirGit <no-reply@example.com>
# SMTP_STARTTLS=true

# --- LLM (any OpenAI-compatible endpoint) -----------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_VISION_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=120

# Local alternatives:
#   Ollama:     LLM_BASE_URL=http://127.0.0.1:11434/v1   LLM_API_KEY=ollama
#   LM Studio:  LLM_BASE_URL=http://127.0.0.1:1234/v1    LLM_API_KEY=lmstudio
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional: replace the built-in interview-copilot persona.
# SYSTEM_PROMPT=You are an interview assistant…

# --- Deepgram (optional; enables /api/stt/token) ----------------------------
# DEEPGRAM_API_KEY=
# nova-3 is cheaper and more accurate than nova-2 (see deepgram.com/pricing).
DEEPGRAM_MODEL=nova-2
DEEPGRAM_TOKEN_TTL_SECONDS=600

# --- Misc -------------------------------------------------------------------
APP_VERSION=0.2.2
# Comma-separated origins for browser clients.  Empty (the default) disables
# CORS entirely — right for the desktop client, and it keeps a random website
# from driving this API through the browser.
CORS_ORIGINS=
