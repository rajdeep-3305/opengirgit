# OpenGirGit client — copy to client/.env to override defaults.
# Values are persisted to ~/.opengirgit/config.json on first run; the .env file
# is only read at startup for these keys.

OPENGIRGIT_SERVER_URL=http://127.0.0.1:8000

# Speech-to-text: "local" (faster-whisper, private) or "deepgram" (cloud)
OPENGIRGIT_STT_ENGINE=local
OPENGIRGIT_WHISPER_MODEL=base.en
OPENGIRGIT_WHISPER_COMPUTE_TYPE=int8
OPENGIRGIT_LANGUAGE=en

# Audio: "system" (loopback, Windows) or "microphone"; empty device = default
OPENGIRGIT_AUDIO_SOURCE=system
OPENGIRGIT_AUDIO_DEVICE=

# Behaviour
OPENGIRGIT_AUTO_ASK=true
OPENGIRGIT_OPACITY=0.96
# OPENGIRGIT_SCREENSHOT_PROMPT=Read the problem in this screenshot and solve it.
