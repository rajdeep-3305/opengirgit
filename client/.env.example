# OpenGirGit client — copy to client/.env to override defaults.
# Values are persisted to ~/.opengirgit/config.json on first run; the .env file
# is only read at startup for these keys.

OPENGIRGIT_SERVER_URL=http://127.0.0.1:8000

# Speech-to-text: "local" (faster-whisper, private) or "deepgram" (cloud)
OPENGIRGIT_STT_ENGINE=local
OPENGIRGIT_WHISPER_MODEL=base.en
OPENGIRGIT_WHISPER_COMPUTE_TYPE=int8
OPENGIRGIT_LANGUAGE=en
# Silence (seconds) that ends an utterance: lower = transcript appears sooner
OPENGIRGIT_SILENCE_SECONDS=0.9

# Audio: "system" (WASAPI loopback) or "microphone"; empty device = default
OPENGIRGIT_AUDIO_SOURCE=system
OPENGIRGIT_AUDIO_DEVICE=

# Behaviour
OPENGIRGIT_AUTO_ASK=true
OPENGIRGIT_PARTIALS=true
OPENGIRGIT_DECOY_CURSOR=true
# Math/mermaid answers render in an embedded web view; set false to save memory
OPENGIRGIT_WEB_RENDER=true
OPENGIRGIT_OPACITY=0.96
# OPENGIRGIT_SCREENSHOT_PROMPT=Read the problem in this screenshot and solve it.

# Transport: "auto" (WebSocket, falls back to SSE) | "sse" | "websocket"
OPENGIRGIT_CHAT_TRANSPORT=auto

# Interface: language catalog code ("en", "de", … or "auto" = desktop locale)
# and optional scaling in percent (0 = follow the system DPI, e.g. 125)
OPENGIRGIT_UI_LANGUAGE=en
OPENGIRGIT_UI_SCALE=0
